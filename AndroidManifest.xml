<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="3"
    android:versionName="1.0.2"
    android:compileSdkVersion="35"
    android:compileSdkVersionCodename="15"
    package="com.p2re.prototype2"
    platformBuildVersionCode="35"
    platformBuildVersionName="15">
    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="true"
        android:version="0x401000"/>
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false"/>
    <application
        android:label="Prototype 2"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:largeHeap="true"
        android:isGame="true"
        android:extractNativeLibs="true"
        android:appCategory="game"
        android:requestLegacyExternalStorage="true">
        <profileable android:shell="true"/>
        <activity
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="screenSize|screenLayout|orientation|navigation|keyboardHidden|keyboard">
            <meta-data
                android:name="android.app.lib_name"
                android:value="p2re"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:name="com.p2re.prototype2.FolderPicker"
            android:exported="false"/>
    </application>
</manifest>
